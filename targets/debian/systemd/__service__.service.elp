<%- (when (and dockerized (not has_unit)) -%>
[Unit]
Description=<%= desc %> (<%= name %>)
<%- ; after_host_units: units outside the manifest (host services,
   ; systemd targets) this service must not start before. Wants= as well
   ; as After=, because ordering alone does nothing for a unit that ships
   ; disabled -- Wants= pulls it in. Weak on purpose: if the unit is
   ; absent or fails, this service still starts.
-%>
After=docker.service mediaserver-network.service<% (when use_vpn %> wireguard.service<% ) %><%= (format nil "~{ ~A~}" (getf service :after_host_units)) %>
Requires=docker.service mediaserver-network.service
PartOf=mediaserver-network.service mediaserver.target
<%- (let ((hu (getf service :after_host_units))) (when hu -%>
Wants=<%= (format nil "~{~A~^ ~}" hu) %>
<%- )) -%>
<%- (when use_vpn -%>
BindsTo=wireguard.service
<% ) -%>

[Service]
Type=simple
TimeoutStartSec=0
Restart=on-failure
RestartSec=10
<%- (when use_vpn -%>
ExecStartPre=/bin/sh -c 'for i in {1..30}; do docker inspect wireguard --format="{{.State.Health.Status}}" 2>/dev/null | grep -q healthy && exit 0; sleep 1; done; exit 1'
<% ) -%>
<%- ; --force-recreate covers two unrelated needs.
   ; use_vpn: network_mode: container:wireguard caches wireguard's
   ; container id at create time. If wireguard was recreated, that
   ; reference breaks and these services can't spin up.
   ; recreate_on_start: the service carries state in its container's
   ; read-write layer that a stop/start cycle does not clear, so
   ; reusing the container wedges it. Only a new layer resets it.
-%>
ExecStart=/usr/bin/docker compose -f <%= compose_file %> up <% (when (or use_vpn (getf service :recreate_on_start)) %>--force-recreate <% ) %><%= name %>
ExecStop=/usr/bin/docker compose -f <%= compose_file %> stop <%= name %>
<%- (when sighup_reload -%>
ExecReload=/usr/bin/docker compose -f <%= compose_file %> kill --signal SIGHUP <%= name %>
<% ) -%>
<%- (when api_config -%>
# api-config holds upstream HTTP-API state that doesn't survive a
# container recreate (e.g. qbit's Password_PBKDF2 if SIGKILLed
# mid-flush, arr download-client wiring on a fresh /config). Kick
# api-config every time the upstream restarts so it reconciles
# without waiting for one of api-config's own files to change.
# --no-block: fire-and-forget; api-config is Type=oneshot and
# idempotent, so multiple triggers during stack-wide boot are noise
# at worst.
ExecStartPost=/bin/systemctl --no-block start api-config.service
<% ) -%>

[Install]
WantedBy=mediaserver.target
<% ) -%>
