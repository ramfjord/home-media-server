---
name: vaultwarden
partof: security
desc: Password manager
port: 80
healthz: "/alive"
# Vaultwarden doesn't natively serve under a subpath, so it gets a
# dedicated host port instead of path-routing under the main FQDN.
# caddy publishes the matching host port.
public_port: 8000
public_path: /
user: root  # no dedicated host user; image runs as its own internal user
docker_config:
  image: vaultwarden/server:latest
  volumes:
  - "<%= install_base %>/config/vaultwarden:/data"
  environment:
  - LOG_LEVEL=info
  - DOMAIN=https://<%= hostname %>:8000
  - SMTP_HOST=smtp
  - SMTP_PORT=25
  - SMTP_SECURITY=off
  - SMTP_FROM=<%= (for-service :smtp from) %>
  - SMTP_FROM_NAME=Vaultwarden
  restart: unless-stopped
order: 90
# Controller-only: plaintext creds rendered for one-time Bitwarden import.
# Excluded from `make sync` and the deploy manifest so they never reach the
# host or vaultwarden's /data volume. See targets/debian/.sync-exclude.elp.
sync_exclude:
- passwords.csv
