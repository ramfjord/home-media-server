<%- ;; Chrome/Bitwarden CSV format (4 cols: name,url,username,password). Renders
    ;; locally only — Makefile's sync target excludes /vaultwarden/passwords.csv,
    ;; so this file never reaches the deploy host. Intended for one-time
    ;; bootstrap import into Bitwarden via "Import → Chrome (csv)" right after
    ;; first signup. write-csv-row appends its own newline.
-%>
<%= (cl-csv:write-csv-row '("name" "url" "username" "password")) -%>
<%- (loop-services (service-where (and admin_username admin_password public_url)) -%>
<%= (cl-csv:write-csv-row (list name public_url admin_username admin_password)) -%>
<%- ) -%>
