---
name: radarr
partof: downloading
desc: find movies
port: 7878
# Mirrors RADARR__SERVER__URLBASE below. derive.lisp folds this into
# `internal_url` so callers (exportarr-radarr, internal blackbox probe,
# api-config) compose against one source of truth.
internal_path: /radarr
healthz: /ping
use_vpn: true
group: mediaserver
docker_config:
  image: lscr.io/linuxserver/radarr:latest
  volumes:
  - "<%= install_base %>/config/radarr:/config"
  - "<%= media_path %>:/data"
  environment:
  - RADARR__SERVER__URLBASE=/radarr
  - "RADARR__AUTH__APIKEY=<%= (for-service :radarr apikey) %>"
  - "RADARR__AUTH__METHOD=External"
  - "RADARR__AUTH__REQUIRED=DisabledForLocalAddresses"
  restart: unless-stopped
api_config:
  api_version: v3
  auth: { type: header, name: X-Api-Key, value: "<%= (for-service :radarr apikey) %>" }
  extra_mutate_query: { forceSave: true }
# Literal block: passed through to api-config as a verbatim YAML
# fragment so that camelCase JSON body keys (configContract,
# implementationName, …) survive the manifest round-trip — the
# manifest builder otherwise lowercases all keyword keys.
api_resources: |
  upserts:
    downloadclient:
    - name: qBittorrent
      enable: true
      protocol: torrent
      priority: 1
      implementation: QBittorrent
      implementationName: qBittorrent
      configContract: QBittorrentSettings
      fields:
      - { name: host,          value: localhost }
      - { name: port,          value: <%= (for-service :qbittorrent port) %> }
      - { name: username,      value: "<%= (for-service :qbittorrent admin_username) %>" }
      - { name: password,      value: "<%= (for-service :qbittorrent admin_password) %>" }
      - { name: movieCategory, value: movies-radarr }
order: 20

# Gated behind Authelia. Radarr is already RADARR__AUTH__METHOD=External
# (delegates UI auth to the reverse proxy), so the gateway becomes its
# actual authentication with no Radarr-side change. API/M2M clients
# (api-config, Prowlarr, exportarr) bypass Caddy and are unaffected.
gateway_auth: true
