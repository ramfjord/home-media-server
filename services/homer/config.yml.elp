---
title: Media Server
subtitle: Service Dashboard
logo: logo.png
icon: fas fa-server

<%-
;; Per-service tile: PNG at services/homer/assets/tools/<name>.png if
;; one exists, otherwise the partof-group's fontawesome icon. Lets
;; "no real UI but caddy-fronted" services (mcpo, mcp-grafana, …) tile
;; on homer without needing decorative art. Homer accepts either a
;; `logo:` URL or an `icon:` fontawesome class, not both.
(let ((categories
       (sort (remove-duplicates
              (mapcar (field :partof) (service-where displayable))
              :test #'equal)
             #'string<))
      (icons '(("downloading" . "fas fa-cloud-download-alt")
               ("streaming"   . "fas fa-play-circle")
               ("vpn"         . "fas fa-shield-alt")
               ("security"    . "fas fa-lock")
               ("llm"         . "fas fa-robot")
               ("monitoring"  . "fas fa-chart-line")))
      (fallback-icon "fas fa-cube"))
  (flet ((tile-png? (svc-name)
           (probe-file (format nil "services/homer/assets/tools/~A.png" svc-name))))
-%>
services:
<%- (dolist (category categories) -%>
  - name: "<%= (str:capitalize category) %>"
    icon: "<%= (or (cdr (assoc category icons :test #'equal)) "fas fa-folder") %>"
    items:
<%-   (loop-services (service-where (and displayable (equal partof category))) -%>
      - name: "<%= (str:capitalize name) %>"
        subtitle: "<%= desc %>"
<%-     (cond ((tile-png? name) -%>
        logo: "assets/tools/<%= name %>.png"
<%-     ) (t -%>
        icon: "<%= (or (cdr (assoc partof icons :test #'equal)) fallback-icon) %>"
<%-     )) -%>
        url: "<%= (or public_url (format nil "https://~A/~A" hostname name)) %>"
        target: "_blank"
<%- )))) -%>
