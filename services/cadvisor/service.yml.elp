---
name: cadvisor
partof: monitoring
desc: Container metrics exporter
port: 8080
# Matches --url_base_prefix below. Same role as --web.route-prefix on
# prometheus/blackbox-exporter — different flag spelling, same effect.
internal_path: /cadvisor
user: root  # needs root to read docker.sock and /dev/kmsg
scrape_target:
  port: 8080
  # cadvisor measures containers; a metric's `service` is the container
  # being measured, not whatever the cadvisor scrape job's service is.
  metric_relabel_configs:
    - source_labels: [name]
      target_label: service
docker_config:
  # Pinned (not :latest) so a cadvisor upgrade that renames/drops a
  # metric we alert on (container_health_state) is a reviewable diff
  # rather than silent image drift.
  image: gcr.io/cadvisor/cadvisor:v0.55.1
  # The image's built-in HEALTHCHECK wgets $CADVISOR_HEALTHCHECK_URL,
  # which defaults to /healthz — a 404 under --url_base_prefix. Point it
  # at the prefixed path so the healthcheck matches where cadvisor serves.
  environment:
  - TZ=Etc/UTC
  - CADVISOR_HEALTHCHECK_URL=http://localhost:8080/cadvisor/healthz
  command:
  - "--url_base_prefix=/cadvisor"
  # Resource ceiling flags. cadvisor's defaults are tuned for a small
  # cgroup tree; on this host they cost ~6 of 8 cores steady-state and
  # leak RSS to >1.5G over a week.
  #
  # 1s is the per-container housekeeping floor. 30s matches
  # prometheus scrape_interval — anything finer is sampled away.
  - "--housekeeping_interval=30s"
  # Skip the systemd/raw cgroup tree. Only docker containers are
  # scraped, and every non-docker slice is dead weight.
  - "--docker_only=true"
  # Container labels and env become prometheus labels by default,
  # multiplying series per container. name/alias/image still emit.
  - "--store_container_labels=false"
  # Allowlist, not a denylist: overrides --disable_metrics entirely, so
  # a new default-on family in a future image cannot silently reappear.
  # Covers everything consumed here (container_cpu_usage_seconds_total,
  # container_memory_*, container_network_*, container_fs_writes_bytes_total);
  # container_health_state is ungated and always emitted.
  # Chiefly drops `disk`, which stat()s every mount cadvisor can see —
  # each overlay2 layer reachable via several nested paths through the
  # /rootfs bind, plus the multi-TB NFS media mount.
  - "--enable_metrics=cpu,memory,network,diskIO,oom_event"
  volumes:
  - "/:/rootfs:ro"
  - "/var/run:/var/run:ro"
  - "/sys:/sys:ro"
  - "/var/lib/docker/:/var/lib/docker:ro"
  - "/dev/disk/:/dev/disk:ro"
  privileged: true
  devices:
  - "/dev/kmsg"
  restart: unless-stopped
  # Backstop: a leak gets OOM-killed and restarted rather than pushing
  # the host into swap. Steady-state RSS is ~150-200M.
  mem_limit: 1g
order: 140
