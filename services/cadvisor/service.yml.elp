---
name: cadvisor
partof: monitoring
desc: Container metrics exporter
port: 8080
# Matches --url_base_prefix below. Same role as --web.route-prefix on
# prometheus/blackbox-exporter — different flag spelling, same effect.
internal_path: /cadvisor
user: root  # needs root to read docker.sock and /dev/kmsg
scrape_target:
  port: 8080
  # cadvisor measures containers; a metric's `service` is the container
  # being measured, not whatever the cadvisor scrape job's service is.
  metric_relabel_configs:
    - source_labels: [name]
      target_label: service
docker_config:
  # Pinned (not :latest) so a cadvisor upgrade that renames/drops a
  # metric we alert on (container_health_state) is a reviewable diff
  # rather than silent image drift.
  image: gcr.io/cadvisor/cadvisor:v0.55.1
  # The image's built-in HEALTHCHECK wgets $CADVISOR_HEALTHCHECK_URL,
  # which defaults to /healthz — a 404 under --url_base_prefix. Point it
  # at the prefixed path so the healthcheck matches where cadvisor serves.
  environment:
  - TZ=Etc/UTC
  - CADVISOR_HEALTHCHECK_URL=http://localhost:8080/cadvisor/healthz
  command:
  - "--url_base_prefix=/cadvisor"
  volumes:
  - "/:/rootfs:ro"
  - "/var/run:/var/run:ro"
  - "/sys:/sys:ro"
  - "/var/lib/docker/:/var/lib/docker:ro"
  - "/dev/disk/:/dev/disk:ro"
  privileged: true
  devices:
  - "/dev/kmsg"
  restart: unless-stopped
order: 140
