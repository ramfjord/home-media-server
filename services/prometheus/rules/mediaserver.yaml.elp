groups:
- name: MediaServer
  rules:
    - alert: SystemdUnitFailed
      # Alert on failed, not "not active": oneshot units (e.g.
      # api-config) are inactive between path-triggered reconciles by
      # design, so `state!=active` would page on every successful run.
      # `state=failed` fires only when systemd actually marks the unit
      # as having failed.
      expr: node_systemd_unit_state{service=~".+", state="failed"} == 1
      for: 5m
      annotations:
        summary: "{{ $labels.service }} - systemd unit {{ $labels.name }} failed"

    - alert: ContainerUnhealthy
      # cadvisor's container_health_state: 1 healthy, 0 unhealthy, -1 no
      # healthcheck. A running-but-unhealthy container keeps up==1 and a
      # green systemd unit, so neither TargetDown nor SystemdUnitFailed
      # catches it — this rule is the only thing watching docker health.
      # service!="" drops the cgroup-slice rows; 10m rides out the
      # start_period/restart window so recreates don't flap.
      expr: container_health_state{service!=""} == 0
      for: 10m
      annotations:
        summary: "{{ $labels.service }} - container failing its Docker healthcheck for 10m"

    - alert: VolumeFillingUp
      expr: |
        predict_linear(node_filesystem_avail_bytes{fstype=~"ext4|xfs|btrfs|zfs|vfat|exfat|ntfs|fuseblk"}[24h], 5 * 24 * 3600) <= 0
        and node_filesystem_avail_bytes{fstype=~"ext4|xfs|btrfs|zfs|vfat|exfat|ntfs|fuseblk"} > 0
      labels:
        partof: streaming
        service: disk
      annotations:
        summary: '{{ $labels.mountpoint }} ({{ $labels.device }}): {{ with query (printf `node_filesystem_size_bytes{instance="%s",mountpoint="%s"} - node_filesystem_avail_bytes{instance="%s",mountpoint="%s"}` $labels.instance $labels.mountpoint $labels.instance $labels.mountpoint) }}{{ . | first | value | humanize1024 }}B{{ end }}/{{ with query (printf `node_filesystem_size_bytes{instance="%s",mountpoint="%s"}` $labels.instance $labels.mountpoint) }}{{ . | first | value | humanize1024 }}B{{ end }}, full in {{ with query (printf `-node_filesystem_avail_bytes{instance="%s",mountpoint="%s"} / deriv(node_filesystem_avail_bytes{instance="%s",mountpoint="%s"}[24h]) / 86400` $labels.instance $labels.mountpoint $labels.instance $labels.mountpoint) }}{{ . | first | value | printf "%.2f" }}d{{ end }}'
        description: "Volume {{ $labels.mountpoint }} on {{ $labels.instance }} is projected to fill within 5 days based on the last 24h of usage"

    # Disabled - media mount not reported by node_exporter
    # - alert: MediaVolumeUnmounted
    #   expr: absent(node_filesystem_avail_bytes{mountpoint=~"/media.*"})
    #   labels:
    #     partof: streaming
    #     service: disk
    #   annotations:
    #     description: "The media volume is unmounted for some reason"
