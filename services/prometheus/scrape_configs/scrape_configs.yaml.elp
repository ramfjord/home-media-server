# Loaded via prometheus.yml's `scrape_config_files: scrape_configs/*.yaml`.
# File format: top-level `scrape_configs:` key whose value is a list of
# scrape_config entries.
#
# Three loops:
#   1. Services with `scrape_target` truthy → direct exporter scrapes.
#   2. Dockerized services with a `healthz` (and not host-net) → internal
#      blackbox probe via container DNS.
#   3. Displayable services → public blackbox probe via the caddy URL.

scrape_configs:
<%- (loop-services (service-where scrape_target) -%>
<%-   (let* ((st (and (listp scrape_target) scrape_target))
             ;; Default metrics_path to <internal_path>/metrics. Services
             ;; whose binary serves under --web.route-prefix=X (prometheus,
             ;; alertmanager, blackbox-exporter) declare internal_path: /X,
             ;; so /metrics composes correctly without each scrape target
             ;; hand-coding it. Override with scrape_target.metrics_path
             ;; for the rare case the metrics endpoint isn't <prefix>/metrics.
             (mpath (or (getf st :metrics_path)
                        (when (and internal_path
                                   (not (string= internal_path "")))
                          (format nil "~A/metrics" internal_path))))) -%>
  - job_name: '<%= name %>'
<%-   (when mpath -%>
    metrics_path: <%= mpath %>
<%-   ) -%>
    static_configs:
      - targets:
        - <%= (or (getf st :host) name) %>:<%= (or (getf st :port) port) %><%= (or (getf st :path) "") %>
        labels:
          job: <%= name %>
          service: <%= (or (getf st :service) name) %>
          partof: <%= partof %>
<%-   (let ((rules (getf st :metric_relabel_configs))) (when rules -%>
    metric_relabel_configs: <%= (yaml:emit-to-string (plist-tree->dict rules)) %>
<%-   )) -%>
<%- )) -%>

  # SNMP scrape of Synology NAS via snmp_exporter (disabled until NAS is set up).
  # Uncomment together with the snmp-exporter service in services.yml and set
  # snmp_host in config.local.yml.
  # - job_name: 'snmp_synology'
  #   metrics_path: /snmp
  #   params:
  #     module: [synology]
  #     auth: [synology_v3]
  #   static_configs:
  #     - targets:
  #       - <%= (or (getf globals :snmp-host) "synology.local") %>
  #       labels:
  #         service: synology-nas
  #         partof: storage
  #   relabel_configs:
  #     - source_labels: [__address__]
  #       target_label: __param_target
  #     - source_labels: [__param_target]
  #       target_label: instance
  #     - target_label: __address__
  #       replacement: "snmp-exporter:9116"

  # HTTP probes via blackbox-exporter. Two layers:
  #
  #   internal_probe_<svc>   — container DNS, hits the service's
  #                            declared healthz path. Confirms the
  #                            container is up and serving.
  #   public_probe_<svc>     — public_url that Homer's tile links
  #                            to. Confirms caddy routing, TLS, and
  #                            the auth chain end-to-end. Catches
  #                            failures the internal probe can't
  #                            see (wrong matcher, bare-vs-slash
  #                            404, host-header rejection).
  #
  # `metrics_path` is composed from blackbox-exporter's declared
  # `internal_path` (which mirrors --web.route-prefix). Single
  # source of truth — flipping the prefix updates every probe job.
<%- (loop-services (service-where (and dockerized healthz
                                       (not (equal (getf docker_config :network_mode)
                                                   "host")))) -%>
  - job_name: 'internal_probe_<%= name %>'
    metrics_path: <%= (for-service :blackbox-exporter internal_path) %>/probe
    params:
      module: [http_basic]
    static_configs:
      - targets:
        - <%= internal_url %><%= healthz %>
        labels:
          service: <%= name %>
          partof: <%= partof %>
          description: "<%= desc %>"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "blackbox-exporter:9115"
<%- ) -%>
<%- (loop-services (service-where displayable) -%>
  - job_name: 'public_probe_<%= name %>'
    metrics_path: <%= (for-service :blackbox-exporter internal_path) %>/probe
    params:
      # gateway_protected services answer an unauthenticated probe with
      # the gateway's 401 challenge — that's healthy (gate enforced),
      # so probe with http_gated (valid_status_codes:[401]). Un-gated
      # services still expect 2xx via http_basic. Keys off the derived
      # gateway_protected flag — no service names here.
      module: [<%= (if gateway_protected "http_gated" "http_basic") %>]
    static_configs:
      - targets:
        - <%= public_url %>
        labels:
          service: <%= name %>
          partof: <%= partof %>
          description: "<%= desc %>"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "blackbox-exporter:9115"
<%- ) -%>
