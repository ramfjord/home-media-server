---
name: smtp
partof: infra
desc: SMTP relay (forwards mail from any service to upstream provider)
user: root  # postfix manages its own internal users
docker_config:
  image: boky/postfix:latest
  environment:
  - ALLOWED_SENDER_DOMAINS=<%= (for-service :smtp allowed_sender_domains) %>
  - RELAYHOST=[<%= (for-service :smtp relay_host) %>]:<%= (for-service :smtp relay_port) %>
  - RELAYHOST_USERNAME=<%= (for-service :smtp relay_username) %>
  - RELAYHOST_PASSWORD=<%= (for-service :smtp relay_password) %>
  - RELAYHOST_TLS_LEVEL=encrypt
  - HOSTNAME=smtp.mediaserver.local
  restart: unless-stopped
order: 5
