[Application]
FileLogger\Age=1
FileLogger\AgeType=1
FileLogger\Backup=false
FileLogger\DeleteOld=false
FileLogger\Enabled=true
FileLogger\MaxSizeBytes=1073741824
FileLogger\Path=/config/qBittorrent/logs

[BitTorrent]
Session\AddTorrentStopped=false
# Pin libtorrent to the WireGuard tunnel interface. qBittorrent shares
# wireguard's netns, which also contains eth0 (the docker bridge ->
# host -> home IP). Without this, libtorrent binds all interfaces and
# uses whatever the kernel routes it to, so any window where wg-quick's
# policy-routing rules are absent (tunnel/container restart, startup
# race) sends already-active torrents out the home IP. Bound to wg0,
# libtorrent fails closed: if wg0 is gone it stalls instead of falling
# back to eth0. (Not a complete fix on its own -- libtorrent's bind has
# historically not covered tracker/DHT/DNS; the netns killswitch is the
# categorical backstop. See services/qbittorrent/README.md.)
Session\Interface=wg0
Session\InterfaceName=wg0
Session\DefaultSavePath=/data/torrents
Session\ExcludedFileNames=
Session\GlobalDLSpeedLimit=0
Session\GlobalUPSpeedLimit=5000000
Session\IgnoreSlowTorrentsForQueueing=true
Session\MaxActiveDownloads=5
Session\MaxActiveTorrents=30
Session\MaxActiveUploads=20
Session\Port=59732
Session\QueueingSystemEnabled=true
Session\SSL\Port=31137
Session\ShareLimitAction=Stop

[Core]
AutoDeleteAddedTorrentFile=Never

[Meta]
MigrationVersion=8

[Network]
Proxy\HostnameLookupEnabled=false
Proxy\Profiles\BitTorrent=true
Proxy\Profiles\Misc=true
Proxy\Profiles\RSS=true

[Preferences]
Downloads\SavePath=/data/torrents
General\Locale=en
MailNotification\req_auth=true
WebUI\AuthSubnetWhitelist=0.0.0.0/0
WebUI\AuthSubnetWhitelistEnabled=true

[RSS]
AutoDownloader\DownloadRepacks=true
AutoDownloader\SmartEpisodeFilter=s(\\d+)e(\\d+), (\\d+)x(\\d+), "(\\d{4}[.\\-]\\d{1,2}[.\\-]\\d{1,2})", "(\\d{1,2}[.\\-]\\d{1,2}[.\\-]\\d{4})"

[WebUI]
AuthSubnetWhitelist=0.0.0.0/0
AuthSubnetWhitelistEnabled=true
Authentication=true
Enabled=true
LocalHostAuth=true
Port=8080
UpnpLease=0
