---
name: qbittorrent
partof: downloading
desc: torrent client
port: 8080
# qBittorrent has no URL-base preference — it serves at / and assumes
# root. Give it its own caddy site on 8443 instead of fighting that.
# When changing this, update services/caddy/service.yml `ports:` so
# caddy publishes the matching host port.
public_port: 8443
public_path: /
use_vpn: true
group: mediaserver
docker_config:
  image: lscr.io/linuxserver/qbittorrent:latest
  volumes:
  - "<%= install_base %>/config/qbittorrent:/config"
  - "<%= media_path %>:/data"
  restart: unless-stopped
api_config:
  api_version: v2
  body_format: qbit-form
  # No auth header — qBittorrent.conf.elp sets AuthSubnetWhitelist=0.0.0.0/0,
  # so api-config (which hits qbit through caddy → wireguard:8080,
  # source-IP non-localhost) auth-bypasses entirely. setPreferences
  # below persists Password_PBKDF2 to qBittorrent.conf so the arrs
  # (which DO hit qbit at localhost in wireguard's netns and trigger
  # LocalHostAuth=true) can authenticate with the same configured creds.
# Literal block — preserves camelCase / case-sensitive endpoint paths
# (here: app/setPreferences) through the manifest round-trip.
api_resources: |
  posts:
    app/setPreferences:
      web_ui_username: "<%= (for-service :qbittorrent admin_username) %>"
      web_ui_password: "<%= (for-service :qbittorrent admin_password) %>"
order: 50
