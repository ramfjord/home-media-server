---
name: qbittorrent
partof: downloading
desc: torrent client
port: 8080
# qBittorrent has no URL-base preference — it serves at / and assumes
# root. Give it its own caddy site on 8443 instead of fighting that.
# When changing this, update services/caddy/service.yml `ports:` so
# caddy publishes the matching host port.
public_port: 8443
public_path: /
use_vpn: true
group: mediaserver
# qBittorrent.conf is BOTH our deploy-shipped template AND qBittorrent's
# runtime state file — qbit rewrites it on every shutdown and on every
# api-config setPreferences call. Watching it would feed a path-watcher
# → compose-reload → restart loop. The remaining watched files in
# config_files (README.md, custom-cont-init.d/*) are static, so this
# leaves a meaningful watch surface for actual config changes.
path_exclude:
- qBittorrent/qBittorrent.conf
docker_config:
  image: lscr.io/linuxserver/qbittorrent:latest
  volumes:
  - "<%= install_base %>/config/qbittorrent:/config"
  - "<%= install_base %>/config/qbittorrent/custom-cont-init.d:/custom-cont-init.d:ro"
  - "<%= media_path %>:/data"
  restart: unless-stopped
api_config:
  api_version: v2
  body_format: qbit-form
  # No auth header — qBittorrent.conf.elp sets AuthSubnetWhitelist=0.0.0.0/0,
  # so api-config (now hitting wireguard:8080 *directly* on
  # mediaserver-network — not via caddy — source-IP non-localhost)
  # auth-bypasses entirely. setPreferences below persists
  # Password_PBKDF2 to qBittorrent.conf so the arrs (which DO hit qbit
  # at localhost in wireguard's netns and trigger LocalHostAuth=true)
  # can authenticate with the same configured creds.
# Literal block — preserves camelCase / case-sensitive endpoint paths
# (here: app/setPreferences) through the manifest round-trip.
api_resources: |
  posts:
    app/setPreferences:
      web_ui_username: "<%= (for-service :qbittorrent admin_username) %>"
      web_ui_password: "<%= (for-service :qbittorrent admin_password) %>"
order: 50

# Gated behind Authelia. qBittorrent has no External-auth mode, but
# AuthSubnetWhitelist=0.0.0.0/0 (qBittorrent.conf.elp) means a
# non-localhost client is auth-bypassed by qbit itself — so the
# browser path (caddy → forward_auth → Authelia → wireguard:8080) gets
# Authelia as its real gate with NO double-login (qbit asks for
# nothing). api-config reaches wireguard:8080 directly off
# mediaserver-network (not via caddy), so forward_auth never touches
# it — the reconcile is unaffected. The arrs hit qbit at localhost in
# wireguard's netns (LocalHostAuth=true), also not via caddy,
# unaffected. (Defense-in-depth follow-up, optional & separable:
# narrow AuthSubnetWhitelist from 0.0.0.0/0 to the docker bridge
# subnet — not required for correctness here.)
gateway_auth: true
