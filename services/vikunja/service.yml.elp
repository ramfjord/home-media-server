---
name: vikunja
partof: productivity
desc: Task management / to-do
port: 3456
# Vikunja can't serve under a URL subpath without rebuilding its
# frontend from source (VIKUNJA_FRONTEND_BASE at build time) — the
# stock image is pre-built for root. So it takes a dedicated caddy
# site on a host port instead of path-routing under the main FQDN,
# same shape as vaultwarden/qbittorrent. When changing public_port,
# update services/caddy/service.yml `ports:` so caddy publishes it.
public_port: 8004
public_path: /
# Auth is Vikunja's own Authelia OIDC (VIKUNJA_AUTH_OPENID_* below),
# local login disabled. The :8004 site is a plain reverse proxy, so
# native clients (mobile app, MCP, CLI, CalDAV) reach /api directly and
# authenticate with Vikunja's OIDC / API-token auth.
docker_config:
  image: vikunja/vikunja:latest
  volumes:
  # The image presets VIKUNJA_DATABASE_PATH=/db/vikunja.db; persist /db
  # for the SQLite file and /app/vikunja/files for uploaded attachments.
  - "<%= install_base %>/config/vikunja/db:/db"
  - "<%= install_base %>/config/vikunja/files:/app/vikunja/files"
  environment:
  # Behind a reverse proxy this is how the frontend learns the API URL
  # (and it's used in outgoing emails). Must be the browser-facing URL,
  # scheme + trailing slash. Matches the caddy site at :<public_port>.
  - "VIKUNJA_SERVICE_PUBLICURL=https://<%= hostname %>:8004/"
  # Required secret (config.local.yml). Read via for-service so an
  # absent value fails `make all` instead of silently auto-generating a
  # per-boot secret that logs everyone out on restart. Env var is
  # VIKUNJA_SERVICE_SECRET (the old VIKUNJA_SERVICE_JWTSECRET is
  # deprecated and ignored when SECRET is set).
  - "VIKUNJA_SERVICE_SECRET=<%= (for-service :vikunja jwt_secret) %>"
  # OIDC via Authelia (services/authelia identity_providers.oidc). The
  # provider id `authelia` matches the redirect_uri path segment in the
  # Authelia client. authurl is Authelia's issuer — reachable from this
  # container server-side (discovery/token) and from the browser, same
  # URL. clientsecret is the plaintext; Authelia stores its pbkdf2 hash.
  - "VIKUNJA_AUTH_OPENID_ENABLED=true"
  - "VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_NAME=Authelia"
  - "VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_AUTHURL=https://<%= hostname %>:9091"
  - "VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTID=vikunja"
  - "VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTSECRET=<%= (for-service :vikunja oidc_client_secret) %>"
  - "VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_SCOPE=openid profile email"
  # OIDC is the only identity — no local Vikunja accounts to orphan or
  # reconcile against the Authelia identity. Flip to true to restore the
  # built-in username/password login as a fallback.
  - "VIKUNJA_AUTH_LOCAL_ENABLED=false"
  restart: unless-stopped
# OIDC-only (local login disabled): if Vikunja boots before Authelia is
# ready it fails to init the provider — and with no local fallback, the
# stack offers no way in. Authelia restarting lags caddy, returning 502
# during the window (observed on first deploy). Gate startup on
# Authelia's docker healthcheck, the same readiness pattern the VPN
# services use for wireguard. Top-level scope: only globals bind, so
# the literal service names are hardcoded.
systemd_override: |
  [Unit]
  After=authelia.service
  [Service]
  ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do docker inspect authelia --format="{{.State.Health.Status}}" 2>/dev/null | grep -q healthy && exit 0; sleep 1; done; exit 1'
order: 95
