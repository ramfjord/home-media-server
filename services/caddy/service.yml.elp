---
name: caddy
partof: dashboard
desc: Reverse proxy for VPN services
sighup_reload: true
# Caddy ignores SIGHUP in Docker; use its admin-API reload instead.
# `--force` avoids failing when the new config introduces a different
# admin endpoint setup.
reload_command: /usr/bin/docker exec caddy caddy reload --config /etc/caddy/Caddyfile --force
docker_config:
  image: caddy:latest
  # Caddy runs as the non-root SVC_UID auto-injected by the
  # docker-compose template, so binding 80/443 needs the
  # NET_BIND_SERVICE capability. caddy:latest ships its binary with
  # the matching file capabilities set, so cap_add suffices (no
  # net.ipv4.ip_unprivileged_port_start sysctl needed).
  cap_add:
  - NET_BIND_SERVICE
  volumes:
  - "<%= install_base %>/config/caddy/Caddyfile:/etc/caddy/Caddyfile:ro"
  - "<%= install_base %>/certs:/certs:ro"
  # 80/443 carry the main path-routed FQDN site. Each dedicated-port
  # site emitted from Caddyfile.elp (services with `public_port` !=
  # 443) needs its host port published here too — caddy can't bind
  # what the container doesn't expose. Keep this list in sync with
  # the `public_port:` values across services/*/service.yml.
  ports:
  - 80:80
  - 443:443
  - 8000:8000  # vaultwarden (public_port: 8000)
  - 8443:8443  # qbittorrent (public_port: 8443)
  restart: unless-stopped
order: 10
