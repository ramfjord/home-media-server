# Main site: every displayable service whose public_port is 443
# (the default) is path-routed under <hostname>/<public_path>. Homer
# at root. caddy listens on 443 and auto-redirects 80 -> 443 because
# the site is declared with a hostname.
<%= hostname %> {
  tls /certs/<%= hostname %>.crt /certs/<%= hostname %>.key

  # Both `/foo` and `/foo/*` matchers per service: caddy's `/foo/*`
  # does not match the bare `/foo`, and homer tile URLs are
  # `https://<host>/<name>` (no trailing slash). Without the bare
  # matcher those clicks fall through to the homer catch-all and 404.
<%- (loop-services (service-where (and displayable via_caddy (= public_port 443))) %>
  @<%= name %> path <%= public_path %> <%= public_path %>/*
  handle @<%= name %> {
    reverse_proxy <%= (if use_vpn "wireguard" name) %>:<%= port %>
  }
<%- ) %>

  # Homer dashboard at root. Hand-written: it's excluded from
  # `displayable` and its container listens on 8080 (not :port).
  handle {
    reverse_proxy homer:8080
  }
}

# Dedicated-port sites for services that opt out of path-routing
# (qBittorrent etc.) by setting `public_port`. Same TLS cert. The
# whole host is reverse-proxied to the upstream — public_path is
# typically "/" for these because the upstream doesn't know about a
# prefix. Caddy's container must publish each of these ports; see
# services/caddy/service.yml.
<%- (loop-services (service-where (and displayable via_caddy (/= public_port 443))) %>
<%= hostname %>:<%= public_port %> {
  tls /certs/<%= hostname %>.crt /certs/<%= hostname %>.key
  # Rewrite Host to match the upstream's listening hostport. qBit 5.x
  # rejects requests whose Host port differs from its server port
  # ("Invalid Host header, port mismatch"). Forwarding the original
  # `<hostname>:<public_port>` Host triggers that on every request.
  reverse_proxy <%= (if use_vpn "wireguard" name) %>:<%= port %> {
    header_up Host {upstream_hostport}
  }
}
<%- ) %>
