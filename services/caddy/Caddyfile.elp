# Unified HTTPS site — every displayable service path-routed under
# its name; homer at root. caddy listens on 443 and auto-redirects
# 80 → 443 because the site is declared with a hostname.
<%= hostname %> {
  tls /certs/<%= hostname %>.crt /certs/<%= hostname %>.key
<%- (loop-services (service-where displayable) %>

  handle /<%= name %>/* {
    reverse_proxy <%= (if use_vpn "wireguard" name) %>:<%= port %>
  }
<%- ) %>

  # Homer dashboard at root. Hand-written: it's excluded from
  # `displayable` and its container listens on 8080 (not :port).
  handle {
    reverse_proxy homer:8080
  }
}
