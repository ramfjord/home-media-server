# Main site: every `proxied` service whose public_port is 443 (the
# default) is path-routed under <hostname>/<public_path>. caddy v2
# `handle` blocks are mutually exclusive; ordering doesn't matter
# here because no service path is a proper prefix of another
# (`/foo/*` can't match `/foobar`), so handles emit in manifest
# order. Homer is just another service at /homer — NOT a catch-all.
# Bare `/` 308-redirects to /homer/ for bookmark convenience; any
# genuinely unmatched path gets an explicit 404 (Caddy's default for
# an unhandled request is an empty 200, which would hide routing
# regressions from the public blackbox probe — see
# services/prometheus/README.md). Caddy listens on 443 and
# auto-redirects 80 -> 443 because the site has a hostname.
<%= hostname %> {
  tls /certs/<%= hostname %>.crt /certs/<%= hostname %>.key

  # Both `/foo` and `/foo/*` matchers per service: caddy's `/foo/*`
  # does not match the bare `/foo`, and homer tile URLs are
  # `https://<host>/<name>` (no trailing slash). Without the bare
  # matcher those clicks would fall to the terminal 404.
<%- (loop-services (service-where (and proxied (= public_port 443))) %>
  @<%= name %> path <%= public_path %> <%= public_path %>/*
  handle @<%= name %> {
<%- (when gateway_protected -%>
    forward_auth <%= (for-service :authelia name) %>:<%= (for-service :authelia port) %> {
      uri /api/authz/forward-auth
      copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
<% ) -%>
    reverse_proxy <%= (if use_vpn "wireguard" name) %>:<%= port %>
  }
<%- ) %>

  # Bookmark convenience: bare root only (exact `path /`, never
  # `/*` — `/*` would re-create the catch-all and, since blackbox
  # follows redirects, re-hide the blind spot).
  @root path /
  handle @root {
    # `redir * /homer/ 308`: the explicit `*` matcher is required —
    # a `redir` arg starting with `/` is otherwise parsed as an
    # inline path matcher, making `/homer/` the matcher and `308`
    # the (bogus) destination.
    redir * /homer/ 308
  }

  # Terminal fallback: anything that matched no handle above. Caddy's
  # implicit default here is an empty 200; we force 404 so a broken
  # service route fails its public blackbox probe instead of silently
  # returning success.
  handle {
    error 404
  }
}

# Dedicated-port sites for services that opt out of path-routing
# (qBittorrent etc.) by setting `public_port`. Same TLS cert. The
# whole host is reverse-proxied to the upstream — public_path is
# typically "/" for these because the upstream doesn't know about a
# prefix. Caddy's container must publish each of these ports; see
# services/caddy/service.yml. Separate site blocks keyed by
# host:port, so ordering is irrelevant here.
<%- (loop-services (service-where (and proxied (/= public_port 443))) %>
<%= hostname %>:<%= public_port %> {
  tls /certs/<%= hostname %>.crt /certs/<%= hostname %>.key
<%- (when gateway_protected -%>
  forward_auth <%= (for-service :authelia name) %>:<%= (for-service :authelia port) %> {
    uri /api/authz/forward-auth
    copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
  }
<% ) -%>
<%- ; proxy_preserve_host: known field (authelia declares it), so
   ; read as a bare symbol — inside loop-services the raw plist is
   ; NOT bound as `service`, so (getf service ...) is always nil here;
   ; with-service-scope only binds known fields as symbols. When set
   ; (the auth gateway) skip the qBit Host rewrite entirely: Authelia
   ; needs the original Host + X-Forwarded-* for cookie-domain /
   ; portal-URL correctness, which Caddy's reverse_proxy default
   ; already provides. Absent => current behaviour, byte-identical.
-%>
<%- (unless proxy_preserve_host -%>
  # Rewrite Host to match the upstream's listening hostport. qBit 5.x
  # rejects requests whose Host port differs from its server port
  # ("Invalid Host header, port mismatch"). Forwarding the original
  # `<hostname>:<public_port>` Host triggers that on every request.
<%- ) -%>
  reverse_proxy <%= (if use_vpn "wireguard" name) %>:<%= port %> {
<%- (unless proxy_preserve_host -%>
    header_up Host {upstream_hostport}
<% ) -%>
  }
}
<%- ) %>
