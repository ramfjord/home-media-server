---
name: sonarr
partof: downloading
desc: find new shows
port: 8989
# Mirrors SONARR__SERVER__URLBASE below. derive.lisp folds this into
# `internal_url` so callers (exportarr-sonarr, internal blackbox probe,
# api-config) compose against one source of truth.
internal_path: /sonarr
healthz: /ping
use_vpn: true
group: mediaserver
docker_config:
  image: lscr.io/linuxserver/sonarr:latest
  volumes:
  - "<%= install_base %>/config/sonarr:/config"
  - "<%= media_path %>:/data"
  environment:
  - SONARR__SERVER__URLBASE=/sonarr
  - "SONARR__AUTH__APIKEY=<%= (for-service :sonarr apikey) %>"
  - "SONARR__AUTH__METHOD=External"
  - "SONARR__AUTH__REQUIRED=DisabledForLocalAddresses"
  restart: unless-stopped
api_config:
  api_version: v3
  auth: { type: header, name: X-Api-Key, value: "<%= (for-service :sonarr apikey) %>" }
  extra_mutate_query: { forceSave: true }
# Literal block — see services/radarr/service.yml for rationale.
api_resources: |
  upserts:
    downloadclient:
    - name: qBittorrent
      enable: true
      protocol: torrent
      priority: 1
      implementation: QBittorrent
      implementationName: qBittorrent
      configContract: QBittorrentSettings
      fields:
      - { name: host,       value: localhost }
      - { name: port,       value: <%= (for-service :qbittorrent port) %> }
      - { name: username,   value: "<%= (for-service :qbittorrent admin_username) %>" }
      - { name: password,   value: "<%= (for-service :qbittorrent admin_password) %>" }
      - { name: tvCategory, value: tv-sonarr }
order: 30
