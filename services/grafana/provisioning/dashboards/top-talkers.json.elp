{
  "id": null,
  "uid": "top-talkers",
  "title": "Top Talkers",
  "tags": ["mediaserver"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container fs writes/s (top 10)",
      "description": "Bytes/sec written to container filesystems (cAdvisor). Catches non-log write thrashing — runaway data writes, model downloads, etc.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "topk(10, sum by (name) (rate(container_fs_writes_bytes_total{name!=\"\"}[5m])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Log bytes/s by service (top 10)",
      "description": "Bytes/sec of journald entries via Loki. Catches verbose-but-not-numerous logs (large structured-JSON lines) that the lines/s panel undercounts — e.g. authelia forward-auth spam.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "topk(10, sum by (service) (bytes_rate({job=\"alloy\"}[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Free bytes per filesystem",
      "description": "node_filesystem_avail_bytes per mount. The slope of these lines is what the days-to-full prediction is built on.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs|zfs|vfat|exfat|ntfs|fuseblk\"}",
          "legendFormat": "{{mountpoint}} ({{device}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Days to full",
      "description": "Same predict_linear basis as the VolumeFillingUp alert: -avail / deriv(avail[$__range]) / 86400. The deriv window tracks the dashboard time picker — change the time range to re-cast the projection over a different window. Negative values (avail growing) display as 'growing'; >365d (or stable) displays as 'stable'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "-node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs|zfs|vfat|exfat|ntfs|fuseblk\"} / deriv(node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs|zfs|vfat|exfat|ntfs|fuseblk\"}[$__range]) / 86400",
          "legendFormat": "{{mountpoint}} ({{device}})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "mappings": [
            { "type": "special", "options": { "match": "nan",     "result": { "text": "stable",  "color": "green", "index": 0 } } },
            { "type": "special", "options": { "match": "inf",     "result": { "text": "stable",  "color": "green", "index": 1 } } },
            { "type": "special", "options": { "match": "neg-inf", "result": { "text": "stable",  "color": "green", "index": 2 } } },
            { "type": "range",   "options": { "from": -1e308, "to": 0,     "result": { "text": "growing", "color": "green", "index": 3 } } },
            { "type": "range",   "options": { "from": 365,    "to": 1e308, "result": { "text": "stable",  "color": "green", "index": 4 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green",  "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    }
  ]
}
