apiVersion: 1

datasources:
  # Reads systemd-journal-gatewayd via the journal-proxy sidecar that
  # transforms gatewayd's NDJSON response into a JSON array (Infinity
  # rejects NDJSON with a parse error). proxy reaches gatewayd via
  # host.docker.internal:19531; we reach proxy by container name.
  - name: Journal
    uid: journal
    type: yesoreyeram-infinity-datasource
    access: proxy
    url: http://journal-proxy:19532
    isDefault: false
    editable: true
    jsonData:
      auth_method: none
      allowed_hosts:
        - http://journal-proxy:19532
