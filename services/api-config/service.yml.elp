---
name: api-config
partof: dashboard
desc: Apply declared HTTP-API config to upstream services (qBit + Servarr)
user: root  # no dedicated host user; reads :ro mounts and makes HTTP calls
# A healthcheck give-up means "upstream unreachable, skipping" — a
# by-design skip, not a config failure. configure.py tags it with the
# stable `healthcheck:` token; drop it pre-counter (same mechanism as
# alloy's r8169 NIC noise) so it never pages — neither ServiceLogErrors
# nor ApiConfigReconcileFailed — while it still ships to Loki (the write
# branch is upstream of this drop), so it stays greppable and shows in
# the per-service panel. A real reconcile give-up has no token and is
# left to page.
log_metric_exclude_regex:
- 'ERROR healthcheck: gave up after '
docker_config:
  image: ghcr.io/ramfjord/api-config:latest
  # On mediaserver-network (not host net), reaching each upstream by
  # its internal_url (http://<name|wireguard>:<port>) — NOT via caddy.
  # The old host-net+FQDN+caddy path was chosen for uniformity, but the
  # auth gateway invalidated that calculus: caddy's forward_auth wraps
  # the whole site, so any gated upstream would 302 api-config to the
  # Authelia portal (httpx doesn't follow → step fails). Going direct
  # bypasses the gate entirely (it's caddy-only), so gating an upstream
  # no longer breaks its reconcile. internal_url is plain http to a
  # docker-DNS name, so there's no cert/FQDN to satisfy — the reason
  # host net existed is gone with it. See api-config/upstreams.yaml.elp.
  #
  # Host-networked upstreams (jellyfin) are on no docker network, so
  # internal_url can't resolve from the bridge; map host.docker.internal
  # to the bridge gateway so their api_config base_url can target the
  # host port directly.
  extra_hosts:
  - "host.docker.internal:host-gateway"
  volumes:
  - "<%= install_base %>/config/api-config/upstreams.yaml:/upstreams.yaml:ro"
  - "<%= install_base %>/config/api-config/resources.yaml:/resources.yaml:ro"
  command: ["/upstreams.yaml", "/resources.yaml"]
  restart: "no"
# Oneshot: exits when reconcile finishes. Drop-in overrides the default
# `Type=simple` + `Restart=on-failure` baked into __service__.service.elp.
# TimeoutStartSec is slack over configure.py's retry budget; flows run
# concurrently so the wall bound is ~max(flow) (~7.5min) not sum(flow).
#
# ExecStart is reset (empty line clears the inherited list) to `compose
# run --rm` instead of the base template's `compose up`: `up` does not
# propagate the container's exit code, so an engine-level configure.py
# failure would leave the oneshot looking successful. `run --rm`
# returns the process exit code. Note: configure.py exits non-zero
# ONLY on an api-config *engine* error (flow-firewall / parse / IO) —
# a per-upstream reconcile failure exits 0 and is paged per-target via
# ApiConfigReconcileFailed, NOT via this unit failing. So unit `failed`
# ⇒ "the reconcile engine is down", a strictly narrower signal than
# "something didn't reconcile" (services/api-config/README.md). The compose path is built
# from the global `install_base` + literal service name (mirroring the
# volume lines above): systemd_override is rendered in the manifest's
# top-level scope where only globals bind — per-service/derived fields
# like compose_file are NOT available here.
systemd_override: |
  [Service]
  Type=oneshot
  Restart=no
  TimeoutStartSec=900
  ExecStart=
  ExecStart=/usr/bin/docker compose -f <%= install_base %>/config/api-config/docker-compose.yml run --rm api-config
order: 200
