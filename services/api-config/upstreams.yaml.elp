# Generated from each service.yml's `api_config` block. To wire up a new
# upstream: add `api_config: { ... }` to its service.yml; this file picks
# it up automatically. Schema reference (consumed by tools/api-config/):
#   api_version:        path segment after /api/  (e.g. v3 / v2 / v1)
#   healthcheck_path:   GET'd before reconcile; from each service's `healthz`
#   auth:               optional. {type: header|bearer, name, value}
#   body_format:        json (default) | qbit-form
#   extra_mutate_query: query params on POST/PUT only (e.g. forceSave)
#   base_url:           optional; overrides the internal_url default
#                       (host-net upstreams not reachable by docker DNS)
#
# `base_url` defaults to each service's `internal_url` — http://<name>:<port>
# for bridge services, http://wireguard:<port> for VPN-netns ones
# (the wireguard container holds their netns and is itself on
# mediaserver-network, so this is the same address caddy reverse-proxies
# to). This deliberately does NOT go through caddy: forward_auth gates
# the whole caddy site, so a public_url base would 302 api-config to
# the Authelia portal for any gated upstream and break its reconcile.
# Direct internal_url bypasses the gate (caddy-only) — api-config stays
# auth-exempt by topology, no per-path bypass needed. configure.py
# treats base_url as an opaque HTTP base (httpx, no TLS pinning), so
# plain http to a docker-DNS name is fine. Requires api-config to be on
# mediaserver-network — see api-config/service.yml.elp. A service whose
# api_config sets base_url overrides this default (host-net jellyfin is
# not on docker DNS, so it targets the host gateway instead).
<%
(let ((upstreams (make-hash-table :test 'equal)))
  (dolist (svc (service-where api_config))
    (with-service-scope svc
      (setf (gethash name upstreams)
            (plist-tree->dict
              (append
                (list :base_url (string-right-trim "/" internal_url))
                (when healthz (list :healthcheck_path healthz))
                api_config)))))
  (yaml:with-emitter-to-stream (em *standard-output*)
    (yaml:emit-pretty-as-document em upstreams)))
%>
