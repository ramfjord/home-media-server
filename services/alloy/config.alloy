// Read every entry from systemd-journald, attach `unit`, `level`,
// and `service` labels, count via stage.metrics for prometheus, and
// forward bodies to Loki for grep/tail in Grafana.

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}

	// Strip `.service` from unit names so the `service` Loki label
	// matches the `service` label prometheus uses (set on the alloy
	// scrape's metric_relabel_configs). Keeps grouping/filter labels
	// consistent across logs and metrics.
	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "(.+)\\.service"
		target_label  = "service"
		replacement   = "$1"
	}
}

loki.source.journal "system" {
	forward_to    = [loki.process.metrics.receiver]
	relabel_rules = loki.relabel.journal.rules
	max_age       = "12h"
	labels        = { job = "alloy" }
}

loki.process "metrics" {
	// Bodies flow through to loki.write for storage; stage.metrics
	// runs in-line on each entry to tick prometheus counters.
	forward_to = [loki.write.local.receiver]

	stage.metrics {
		metric.counter {
			name        = "log_lines_total"
			description = "Journald entries seen by Alloy, labelled by unit and level."
			match_all   = true
			action      = "inc"
		}
	}
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
