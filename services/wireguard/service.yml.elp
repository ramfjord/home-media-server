---
name: wireguard
partof: vpn
desc: VPN container
user: root  # container runs as root: NET_ADMIN cap needs UID 0 to use
host_config_owner: 911  # but lscr.io's s6-init chowns /config to UID 911
host_config_group: 911  # (abc user); matching avoids rsync IN_ATTRIB churn
docker_config:
  image: lscr.io/linuxserver/wireguard:latest
  cap_add:
  - NET_ADMIN
  - SYS_MODULE
  sysctls:
    net.ipv4.conf.all.src_valid_mark: 1
  volumes:
  - "<%= install_base %>/config/wireguard:/config"
  - "<%= install_base %>/config/wireguard/custom-cont-init.d:/custom-cont-init.d:ro"
  - "/lib/modules:/lib/modules:ro"
  healthcheck:
    # Verify the tunnel is actually negotiated (fresh handshake), not
    # mere reachability. `ping 1.1.1.1` false-greened (eth0 path before
    # the killswitch) AND false-redded (provider drops ICMP through the
    # tunnel). With the killswitch, a fresh wg0 handshake IS the egress
    # guarantee: eth0 egress is dropped, so tunnel-up <-> exiting via
    # the VPN. ($$ escapes compose interpolation -> $ at deploy.)
    test:
    - CMD-SHELL
    - >-
      t=$$(wg show wg0 latest-handshakes 2>/dev/null | awk '{print $$NF}' | sort -n | tail -1);
      [ -n "$$t" ] && [ "$$t" -gt 0 ] && [ $$(( $$(date +%s) - $$t )) -lt 180 ]
    interval: 30s
    timeout: 10s
    retries: 3
    # Tunnel needs a few seconds to complete its first handshake; gate
    # qbit (ExecStartPre waits for healthy) on the real tunnel, not a
    # premature green.
    start_period: 30s
  restart: unless-stopped
# Default Type=simple marks the unit Active the instant docker compose
# forks, well before the container is healthy. Dependents
# (network_mode: container:wireguard) clear After=wireguard.service
# too early and bind to whatever wireguard container is around —
# which on a stack-wide restart is the about-to-be-recreated one, so
# they end up in a defunct netns. Block ExecStartPost on container
# health so the unit stays in 'activating' until wireguard is really
# up; After=wireguard.service then waits for real readiness.
systemd_override: |
  [Service]
  ExecStartPost=/bin/bash -c 'for i in {1..60}; do docker inspect wireguard --format="{{.State.Status}}/{{.State.Health.Status}}" 2>/dev/null | grep -qx running/healthy && exit 0; sleep 1; done; exit 1'
order: 0
