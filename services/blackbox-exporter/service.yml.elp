---
name: blackbox-exporter
partof: monitoring
desc: Blackbox HTTP probe exporter
port: 9115
# Matches --web.route-prefix below. Prometheus's scrape_target loop and
# blackbox probe metrics_path both compose against this.
internal_path: /blackbox-exporter
scrape_target: true
docker_config:
  image: prom/blackbox-exporter:latest
  command:
  - "--config.file=/etc/blackbox-exporter/blackbox.yml"
  - "--web.external-url=https://<%= hostname %>/blackbox-exporter"
  - "--web.route-prefix=/blackbox-exporter"
  volumes:
  # Kept in this service's own tree so its .path watcher reloads it
  # (a watcher only sees config/<its-own-name>/).
  - "<%= install_base %>/config/blackbox-exporter/blackbox.yml:/etc/blackbox-exporter/blackbox.yml:ro"
  restart: unless-stopped
order: 110
