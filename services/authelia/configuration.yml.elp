# Auto-generated. Source: services/authelia/configuration.yml.elp.
#
# Authelia 4.39 — single sign-on portal fronting the gateway-gated
# web UIs. One-factor (username + password) by default; per-service
# two_factor (WebAuthn/passkey, not TOTP) is wired in a later commit.
# Secrets and the user record live in git-ignored config.local.yml
# (service_overrides.authelia.*) — see services/authelia/README.md
# for the keys and the `authelia crypto` commands that mint them.

theme: light

server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: 'info'

# Signs the identity-verification tokens emailed for password reset.
# Required by the schema even though reset is left at defaults.
identity_validation:
  reset_password:
    jwt_secret: '<%= (for-service :authelia jwt_secret) %>'

# File backend (no LDAP) — the minimal-process constraint. Flat YAML,
# argon2id-hashed passwords.
#
# password_reset.disable: reset is intentionally NOT self-service.
# users_database.yml is config-as-code (sourced from config.local.yml);
# a UI-driven reset would write to the file and be clobbered on the
# next deploy. Reset = re-run script/authelia-adduser and redeploy.
#
# file.watch: Authelia reloads the users file in place when it changes,
# so a deploy that rewrites users_database.yml (added/reset user) takes
# effect without an Authelia restart — no gated-stack blip.
authentication_backend:
  password_reset:
    disable: true
  file:
    path: '/config/users_database.yml'
    watch: true

# one_factor: anything the reverse proxy routes through Authelia
# requires a logged-in user. The monitoring stack is deliberately NOT
# routed through Authelia (break-glass) so it stays reachable to
# debug the portal itself.
access_control:
  default_policy: 'one_factor'

# OpenID Connect provider. Distinct from forward_auth: forward_auth
# gates *access* at caddy; OIDC hands an app a verified *identity* so it
# can key its own accounts to it. An app can use both (forward_auth out
# front, OIDC inside) — Vikunja does. Provider-level secrets live in
# config.local.yml: hmac_secret signs OIDC JWTs, the RS256 jwks key
# signs ID tokens. Both are required by the 4.39 schema to enable OIDC.
identity_providers:
  oidc:
    hmac_secret: '<%= (for-service :authelia oidc_hmac_secret) %>'
    jwks:
      - key_id: 'rs256'
        algorithm: 'RS256'
        use: 'sig'
        key: |
<%= (str:join (string #\Newline)
              (mapcar (lambda (l) (concatenate 'string "          " l))
                      (str:lines (string-right-trim '(#\Newline)
                                   (for-service :authelia oidc_issuer_key))))) %>
    clients:
      # Vikunja (services/vikunja): one_factor to match the current user
      # set — two_factor needs WebAuthn enrolment, not wired yet. The
      # `authelia` path segment in the redirect_uri is the provider id
      # Vikunja is configured with. client_secret is the pbkdf2 hash of
      # the plaintext Vikunja holds (config.local.yml).
      - client_id: 'vikunja'
        client_name: 'Vikunja'
        client_secret: '<%= (for-service :authelia oidc_vikunja_client_secret_hash) %>'
        public: false
        authorization_policy: 'one_factor'
        require_pkce: false
        redirect_uris:
          - 'https://<%= hostname %>:8004/auth/openid/authelia'
        scopes: ['openid', 'profile', 'email']
        response_types: ['code']
        grant_types: ['authorization_code']
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'

      # Audiobookshelf (services/audiobookshelf): path-routed under
      # /audiobookshelf on the main 443 site, so the callbacks carry that
      # prefix — ABS emits them that way because its config sets
      # authOpenIDSubfolderForRedirectURLs. The third URI is the mobile
      # app's custom scheme: the Android/iOS clients complete the code
      # flow in-app, which is why ABS is gated by OIDC rather than by
      # caddy forward_auth. PKCE is on (ABS supports S256).
      #
      # `groups` scope: ABS reads the standard groups claim and maps it
      # onto its own role, which is why the group names in
      # users_database are `admin`/`user` rather than plurals — ABS
      # matches them literally. See services/audiobookshelf/README.md.
      - client_id: 'audiobookshelf'
        client_name: 'Audiobookshelf'
        client_secret: '<%= (for-service :authelia oidc_audiobookshelf_client_secret_hash) %>'
        public: false
        authorization_policy: 'one_factor'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://<%= hostname %>/audiobookshelf/auth/openid/callback'
          - 'https://<%= hostname %>/audiobookshelf/auth/openid/mobile-redirect'
          - 'audiobookshelf://oauth'
        scopes: ['openid', 'profile', 'email', 'groups']
        response_types: ['code']
        grant_types: ['authorization_code']
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'

session:
  secret: '<%= (for-service :authelia session_secret) %>'
  cookies:
    - domain: '<%= hostname %>'
      authelia_url: 'https://<%= hostname %>:9091'

storage:
  encryption_key: '<%= (for-service :authelia storage_encryption_key) %>'
  local:
    path: '/config/db.sqlite3'

# Notifier → the in-stack postfix relay (services/smtp), which
# authenticates upstream to the real provider. Plaintext on the
# internal hop (smtp:25, no TLS/auth), exactly as vaultwarden reaches
# it.
#
# disable_startup_check: Authelia otherwise runs a notifier probe at
# boot and exits *fatally* if smtp:25 isn't answering yet — turning a
# briefly-unready relay into an Authelia crash-loop. Auth gates the
# whole stack; email-at-boot does not. Decouple them: Authelia must
# start regardless of the relay's readiness (Vaultwarden likewise
# doesn't gate startup on SMTP).
notifier:
  disable_startup_check: true
  smtp:
    address: 'smtp://smtp:25'
    sender: '<%= (for-service :smtp from) %>'
    disable_require_tls: true
