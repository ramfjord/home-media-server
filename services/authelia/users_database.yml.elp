# Auto-generated. Source: services/authelia/users_database.yml.elp.
#
# Authelia file backend — one entry per human, sourced from the
# `users:` list under service_overrides.authelia in git-ignored
# config.local.yml. Each `password` is an argon2id HASH, never
# plaintext. Mint or reset a user with:
#
#   script/authelia-adduser <username> [-e email] [-n displayname] [group...]
#
# which prints the generated password once and a ready-to-paste
# config.local.yml block. Reset is not self-service (this file is
# config-as-code; a UI reset would be clobbered next deploy) — re-run
# the script and redeploy. See services/authelia/README.md.
#
# `users` and each entry's `username`/`password_hash` are required: an
# incomplete config.local.yml fails `make all` here, naming the gap,
# rather than at Authelia startup (CONTRIBUTING.md "Required fields").
users:
<%- (dolist (u (for-service :authelia users)) -%>
<%- (let* ((username (or (getf u :username)
                         (error "authelia: a users entry is missing :username in config.local.yml: ~S" u)))
           (pwhash   (or (getf u :password_hash)
                         (error "authelia: user ~A is missing :password_hash in config.local.yml" username)))) -%>
  <%= username %>:
    disabled: false
    displayname: '<%= (or (getf u :displayname) username) %>'
    password: '<%= pwhash %>'
<%- (when (getf u :email) -%>
    email: '<%= (getf u :email) %>'
<%- ) -%>
<%- (when (getf u :groups) -%>
    groups:
<%- (dolist (g (getf u :groups)) -%>
      - <%= g %>
<%- )))) -%>
