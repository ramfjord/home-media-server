---
name: jellyfin
partof: streaming
desc: Alternative media streaming server
port: 8096
group: mediaserver
healthz: "/health"
# Host networking: SSDP/DLNA broadcasts reach LAN clients (Roku,
# smart TVs). Reachable directly at http://<hostname>:8096/ from
# tailnet, and at the host's LAN IP:8096 from local network. No TLS —
# caddy can't reverse-proxy a host-networked container (no docker DNS
# name), so derive.lisp infers `proxied: false` from network_mode
# and the rest of the stack falls into place.
docker_config:
  image: jellyfin/jellyfin:latest
  network_mode: host
  volumes:
  - "<%= install_base %>/config/jellyfin:/config"
  # Bind /cache (transcodes, fontconfig, thumbnails) so the deploy chown
  # loop reaches it. Without this it lands in an anonymous docker volume
  # whose UID drifts on user_id changes and breaks transcoding.
  - "<%= install_base %>/config/jellyfin/cache:/cache"
  - "<%= media_path %>/TV:/media/TV:ro"
  - "<%= media_path %>/Movies:/media/Movies:ro"
  - "/tmp:/tmp"
  environment:
  - JELLYFIN_PublishedServerUrl=http://<%= hostname %>:8096
  restart: unless-stopped
api_config:
  # Jellyfin's primary API is /api/v1/* but the Startup wizard endpoints
  # we drive below live at /Startup/* (no /api prefix). api_version is
  # unused by the steps-only flow here; set for future upsert/post use.
  api_version: v1
  # host-net: jellyfin is on no docker network, so the default
  # internal_url (http://jellyfin:8096) can't resolve from api-config's
  # bridge. Reach its host port via the bridge gateway instead
  # (api-config sets extra_hosts: host.docker.internal:host-gateway).
  base_url: "http://host.docker.internal:8096"
# Literal block — preserves the ELP tags inside so for-service resolves
# at stage 2 with full manifest scope. Gate at step 1: GET /Startup/FirstUser
# returns 200 during setup and 401 once /Startup/Complete has been called,
# so 401 ⇒ already configured ⇒ stop. 200 ⇒ on_failure: continue into the
# first-run sequence. Re-runs on a configured server cost one GET.
api_resources: |
  steps:
    - name: already-set-up?
      request:
        method: GET
        url: $base_url/Startup/FirstUser
      success_when:
        status: 401
      on_success: stop
      on_failure: continue
    - name: server-defaults
      request:
        method: POST
        url: $base_url/Startup/Configuration
        json:
          UICulture: en-US
          MetadataCountryCode: US
          PreferredMetadataLanguage: en
    - name: admin-user
      request:
        method: POST
        url: $base_url/Startup/User
        json:
          Name: "<%= (for-service :jellyfin admin_username) %>"
          Password: "<%= (for-service :jellyfin admin_password) %>"
    - name: complete
      request:
        method: POST
        url: $base_url/Startup/Complete
order: 70
