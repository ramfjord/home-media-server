templates:
  - templates/*.tmpl

route:
  # group_by: [] — every alert lands in ONE group.  For this server, the
  # discord notifications serve primarily as a bulk notification that
  # something should be investigated.
  group_by: []
  group_wait: 5m
  group_interval: 30m
  repeat_interval: 24h
  receiver: discord
  routes:
    # StackStarting / ServiceStarting exist only to inhibit other
    # alerts (see inhibit_rules). They are not incidents, so they
    # terminate here on a receiver with no integrations rather than
    # posting to Discord.
    - matchers:
      - alertname=~"StackStarting|ServiceStarting"
      receiver: 'null'

receivers:
  # Terminal sink for the settle markers. A receiver with no
  # integration configs is a valid drop.
  - name: 'null'

#   - name: 'web.hook'
#     webhook_configs:
#       - url: 'http://127.0.0.1:5001/'
  - name: discord
    discord_configs:
      # Explicit: the recovery post is half the point of the single
      # group, not an incidental default.
      - send_resolved: true
        webhook_url: 'https://discord.com/api/webhooks/1302064758228254812/JEYtJUxH4yt_KBJ8cZqvZI8SWQ7WWDoJeem3PZDdbLiu155Gp-HNRLQc5c-xZn1OFBY4'
        # Alertmanager's built-in discord templates are
        # `discord.default.title` / `discord.default.message`; ours
        # are named differently so we have to reference them
        # explicitly here. Without these lines, our overrides in
        # templates/discord.tmpl are loaded but unused.
        title: '{{ template "discord.title" . }}'
        message: '{{ template "discord.body" . }}'


inhibit_rules:
  # Mute the whole stack while the host boots. No `equal`: with no
  # label names listed the rule applies to every target, which is the
  # intent — at boot everything is failing for the same reason.
  - name: boot-settle
    source_matchers: [ alertname="StackStarting" ]
    target_matchers: [ alertname!="StackStarting" ]

  # Mute one service while its container restarts. `equal: [service]`
  # scopes it to the service that actually restarted; every other
  # service keeps alerting normally.
  #
  # SystemdUnitFailed and ServiceCrashLooping are exempt. A service
  # that restarts faster than ServiceStarting's 10m window keeps the
  # marker permanently true and would otherwise be permanently muted --
  # the crash loop, the loudest failure there is, would be the one
  # thing this rule hides. Both are immune to restart noise by
  # construction: SystemdUnitFailed needs 5 continuous minutes in
  # `failed`, and ServiceCrashLooping counts only automatic restarts,
  # so neither fires for an ordinary restart.
  - name: service-settle
    source_matchers: [ alertname="ServiceStarting" ]
    target_matchers: [ alertname!~"ServiceStarting|SystemdUnitFailed|ServiceCrashLooping" ]
    equal: ['service']
