{{/*
  One post per incident, not per alert. The route groups every alert
  into a single group (group_by: []), so .Alerts is the whole set of
  what is currently wrong with the host.

  Short host name is the FQDN's first label, computed at render.
  Links are absolute and built from each service's public_url.
*/ -}}

{{ define "discord.title" -}}
{{ if eq .Status "firing" }}⚠️  <%= hostname %> is having trouble{{ else }}✅  <%= hostname %> has recovered{{ end }}
{{- end }}

{{ define "discord.body" -}}
[health dashboard](<%= (for-service :grafana public_url) %>/d/stack-health)

{{ if eq .Status "firing" -}}
{{ range $i, $a := .Alerts.Firing -}}
{{ if lt $i 15 }}• `{{ if $a.Labels.service }}{{ $a.Labels.service }}{{ else }}host{{ end }}` — {{ $a.Labels.alertname }}{{ with $a.Annotations.summary }} — {{ . }}{{ end }}
{{ end }}{{- end -}}
{{ if gt (len .Alerts.Firing) 15 }}…and more — see the dashboard
{{ end }}

{{- else -}}
**<%= (subseq hostname 0 (position #\. hostname)) %>** has been stable for <%= (for-service :prometheus alert_keep_firing_for) %>
{{- end }}
{{- end }}
