#!/bin/bash
# Rendered from checks/caddy.sh.elp. DO NOT edit this file directly.
#
# Use `caddy adapt` (Caddyfile → JSON conversion) rather than
# `caddy validate --config`: validate provisions runtime resources
# including TLS cert files, which won't exist on the dev box. adapt
# is parse-only and catches the syntactic / directive errors we care
# about pre-deploy.
set -euo pipefail
<%- (loop-services (service-where (string= name "caddy")) -%>
docker run --rm \
  -v "$PWD/config/caddy:/etc/caddy:ro" \
  <%= (getf docker_config :image) %> \
  caddy adapt --config /etc/caddy/Caddyfile --adapter caddyfile > /dev/null
<%- ) -%>
