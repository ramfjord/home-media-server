# Copy to config.local.yml and customize
# These values override defaults in services.yml

install_base: /opt/mediaserver
media_path: /data

# FQDN the deploy host is reached at — used in service URLs (jellyfin
# PublishedServerUrl, prometheus external_url, homer card links) and as
# the tailscale-cert subject for caddy's HTTPS site. Use the tailnet
# (MagicDNS) name so links work over tailscale and the cert SAN matches.
hostname: your-host.your-tailnet.ts.net

# Per-service public URLs (used in emails, dashboards, etc.) live in
# service_overrides as `public_url` — see Vaultwarden below.
service_overrides:
  # SMTP relay — runs as the `smtp` service on the docker network so any
  # container can send mail via host=smtp port=25 (no auth, internal-only).
  # Upstream is a real provider; for Gmail, generate an app password at
  # https://myaccount.google.com/apppasswords (requires 2FA).
  smtp:
    from: "you@example.com"
    relay_host: "smtp.gmail.com"
    relay_port: 587
    relay_username: "you@example.com"
    relay_password: "REPLACE_ME"
    # Postfix gates outbound mail by envelope-sender domain to prevent
    # the relay from being used as an open relay.
    allowed_sender_domains: "gmail.com"
  # Each *arr app exposes an API key in its own settings UI; copy the
  # generated value here. The bootstrap config.xml seeds this key on
  # first install (cp -n; existing config.xml is left alone), and
  # exporters / Prowlarr consume it via for-service. Generate fresh
  # values with `openssl rand -hex 16`.
  radarr:
    apikey: "REPLACE_ME"
  sonarr:
    apikey: "REPLACE_ME"
  prowlarr:
    apikey: "REPLACE_ME"
  qbittorrent:
    admin_username: "admin"
    admin_password: "REPLACE_ME"
