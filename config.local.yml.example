# Copy to config.local.yml and customize
# These values override defaults in services.yml

install_base: /opt/mediaserver
media_path: /data

# Envelope-from address used by services that send mail through the smtp
# relay. Lives at the top level (not under service_overrides.smtp) because
# other services' service.yml files reference it during stage-1 rendering
# and can't see fields belonging to another service. Once compose
# generation moves back to .elp templates, this can collapse into
# service_overrides.smtp.from and be reached via for-service :smtp.
smtp_from: "you@example.com"

# Per-service public URLs (used in emails, dashboards, etc.) live in
# service_overrides as `public_url` — see Vaultwarden below.
service_overrides:
  # SMTP relay — runs as the `smtp` service on the docker network so any
  # container can send mail via host=smtp port=25 (no auth, internal-only).
  # Upstream is a real provider; for Gmail, generate an app password at
  # https://myaccount.google.com/apppasswords (requires 2FA).
  smtp:
    relay_host: "smtp.gmail.com"
    relay_port: 587
    relay_username: "you@example.com"
    relay_password: "REPLACE_ME"
    # Postfix gates outbound mail by envelope-sender domain to prevent
    # the relay from being used as an open relay.
    allowed_sender_domains: "gmail.com"
  vaultwarden:
    public_url: "https://vaultwarden.example.com"
