---
name: fx-caddy
partof: dashboard
desc: Fixture reverse proxy
sighup_reload: true
reload_command: /usr/bin/docker exec fx-caddy caddy reload --config /etc/caddy/Caddyfile --force
docker_config:
  image: example.invalid/fx-caddy:latest
  volumes:
  - "<%= install_base %>/config/fx-caddy/Caddyfile:/etc/caddy/Caddyfile:ro"
  - "<%= install_base %>/config/fx-caddy/certs:/etc/caddy/certs:ro"
  ports:
  - 18080:18080
  - 18989:18989
  - 19090:19090
  restart: unless-stopped
order: 5
# Declares :sync_exclude as a known field so targets/debian/.sync-exclude.elp
# can `(field :sync_exclude svc)` against the fx-* fixture set without
# tripping the typo guard. Empty here — exclusion behavior is exercised
# by the main checkout's vaultwarden manifest, not by goldens.
sync_exclude: []
