---
name: fx-qbittorrent
partof: downloading
desc: Fixture torrent client
port: 18080
use_vpn: true
docker_config:
  image: example.invalid/fx-qbittorrent:latest
  volumes:
  - "<%= install_base %>/config/fx-qbittorrent:/config"
  - "<%= media_path %>:/data"
  restart: unless-stopped
api_config:
  api_version: v2
  body_format: qbit-form
systemd_override: |
  [Service]
  Type=oneshot
order: 50
