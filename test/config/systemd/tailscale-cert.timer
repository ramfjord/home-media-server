[Unit]
Description=Daily renewal of tailscale cert for fx-host

[Timer]
# Once at 5min after boot to (re-)validate the cert, then daily.
# tailscale cert is idempotent — only rewrites when needed — so the
# daily fire is cheap when the cert is fresh.
OnBootSec=5min
OnUnitActiveSec=1d
Persistent=true

[Install]
WantedBy=timers.target
